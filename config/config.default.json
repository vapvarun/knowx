{
  "theme": {
    "PHPNamespace": "KnowX\\KnowX",
    "slug": "knowx",
    "name": "KnowX",
    "theme_uri": "https://wbcomdesigns.com/downloads/knowx-theme/",
    "author": "wbcomdesigns",
    "author_uri": "https://wbcomdesigns.com",
    "description": "Free theme for a knowledge base",
    "version": "2.0.0"
  },
  "dev": {
    "browserSync": {
      "live": true,
      "proxyURL": "knowx.local/",
      "bypassPort": "8181",
      "https": false,
      "keyPath": "",
      "certPath": ""
    },
    "styles": {
      "stage": 3,
      "preload": [
        "_custom-media.css"
      ],
      "features": {
        "custom-media-queries": true,
        "custom-properties": true,
        "nesting-rules": true,
        "mobile-nav-type": "modern"
      }
    }
  },
  "export": {
    "compress": true,
    "filesToCopy": [
      "LICENSE",
      "readme.txt",
      "screenshot.png",
      "theme.json",
      "assets/css/*.css",
      "assets/css/admin/*.css",
      "assets/css/editor/*.css",
      "assets/js/*.js",
      "assets/js/admin/*.js",
      "assets/fonts/**/*",
      "inc/Customizer_Framework/assets/*"
    ]
  }
}
