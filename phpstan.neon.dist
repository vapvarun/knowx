parameters:
    level: 5
    dynamicConstantNames:
        - WP_DEBUG
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - tests/phpstan-constants.php
    paths:
        - .
    excludePaths:
        - vendor/
        - node_modules/
        - tests/
        - assets/
        - languages/
        - scripts/
        - playground/
